/**
 * This ruleset governs access to a Firestore database for an e-commerce application.
 *
 * Core Philosophy:
 * The security model is a hybrid approach. It provides public, read-only access to catalog
 * information like products and pickup locations, while enforcing a strict user-ownership
 * model for all personal and transactional data, such as orders. An admin role is included
 * to allow privileged access for order management.
 *
 * Data Structure:
 * - /products/{productId}: Publicly readable product catalog.
 * - /pickupPoints/{pickupPointId}: Publicly readable pickup locations.
 * - /users/{userId}/orders/{orderId}: User-specific orders, private to the user but accessible by admins.
 *
 * Key Security Decisions:
 * - Public Data: `/products` and `/pickupPoints` are globally readable. Writes are blocked from the client.
 * - User-Owned Data: Data under `/users/{userId}` is private to that user, enforced by matching `request.auth.uid` with the `{userId}` in the path.
 * - Admin Access: A user with the email 'abraham@clinicpesa.com' has read/write access to all orders.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Returns true if the requesting user is the admin.
     * Admin status is determined by matching the user's email.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'abraham@clinicpesa.com';
    }

    // ------------------------------------------------------------------------
    // Public Collections
    // ------------------------------------------------------------------------

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /pickupPoints/{pickupPointId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    
    // ------------------------------------------------------------------------
    // User-Specific Data
    // ------------------------------------------------------------------------

    match /users/{userId} {
      allow get, list, create, update, delete: if false;

      /**
       * @description Controls access to a user's personal order history.
       * @path /users/{userId}/orders/{orderId}
       * @allow (get, list, create) A user can manage their own orders.
       * @allow (get, list, update, delete) An admin can view, update, or delete any user's order.
       */
      match /orders/{orderId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();

        /**
         * @description Controls access to items within an order.
         * @path /users/{userId}/orders/{orderId}/orderItems/{orderItemId}
         * @principle Inherits ownership from the parent document path. Admins also inherit access.
         */
        match /orderItems/{orderItemId} {
          allow get: if isOwner(userId) || isAdmin();
          allow list: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId) && request.resource.data.orderId == orderId;
          allow update: if (isExistingOwner(userId) || isAdmin()) && request.resource.data.orderId == resource.data.orderId;
          allow delete: if isExistingOwner(userId) || isAdmin();
        }
      }
    }

    /**
     * @description Enables collection group queries for admins.
     * @path /{path=**}/orders/{orderId}
     * @allow (list) An admin can list all documents in any collection named 'orders'.
     */
    match /{path=**}/orders/{orderId} {
      allow list: if isAdmin();
    }
  }
}
